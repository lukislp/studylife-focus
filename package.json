{
  "name": "studylife-focus",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome extension: blocks distracting sites and switches Spotify playlists based on your StudyLife focus session",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node zip.mjs",
    "contract-check": "node scripts/contract-check.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.0.280",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
